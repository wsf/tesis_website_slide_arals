<odoo>
    <data noupdate="1">

        <!-- Datos de demostración para el módulo ARALS -->
        
        <!-- Canal/Curso de demostración -->
        <record id="demo_course_python" model="slide.channel">
            <field name="name">Curso Python Adaptativo - ARALS</field>
            <field name="description">Curso de Python con sistema de recomendaciones adaptativo basado en ARALS</field>
            <field name="website_published">True</field>
            <field name="allow_comment">True</field>
            <field name="promote_strategy">latest</field>
            <field name="enroll">public</field>
        </record>

        <!-- Diapositivas de demostración con diferentes niveles -->
        <record id="demo_slide_python_basics" model="slide.slide">
            <field name="name">Introducción a Python - Variables y Tipos de Datos</field>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="slide_type">article</field>
            <field name="description">Conceptos básicos de Python: variables, tipos de datos y operadores</field>
            <field name="website_published">True</field>
            <field name="nivel_dificultad">basico</field>
            <field name="sequence">1</field>
        </record>

        <record id="demo_slide_python_control" model="slide.slide">
            <field name="name">Estructuras de Control en Python</field>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="slide_type">article</field>
            <field name="description">If, while, for y estructuras de control de flujo</field>
            <field name="website_published">True</field>
            <field name="nivel_dificultad">intermedio</field>
            <field name="sequence">2</field>
        </record>

        <record id="demo_slide_python_oop" model="slide.slide">
            <field name="name">Programación Orientada a Objetos</field>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="slide_type">article</field>
            <field name="description">Clases, objetos, herencia y polimorfismo en Python</field>
            <field name="website_published">True</field>
            <field name="nivel_dificultad">avanzado</field>
            <field name="sequence">3</field>
        </record>

        <!-- Ruta de aprendizaje de demostración -->
        <record id="demo_ruta_aprendizaje" model="slide.ruta.aprendizaje">
            <field name="user_id" ref="base.user_admin"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="nivel_dificultad">intermedio</field>
            <field name="activa">True</field>
            <field name="descripcion">Ruta personalizada de demostración para el sistema ARALS.</field>
            <field name="slide_ids" eval="[(6, 0, [ref('demo_slide_python_basics'), ref('demo_slide_python_control'), ref('demo_slide_python_oop')])]"/>
        </record>

        <!-- Historial de progreso de demostración -->
        <record id="demo_historial_admin_basics" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_admin"/>
            <field name="slide_id" ref="demo_slide_python_basics"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">32.5</field>
            <field name="intentos_quiz">1</field>
            <field name="puntuacion">95</field>
            <field name="fecha_acceso">2025-11-25 09:30:00</field>
            <field name="completado">True</field>
            <field name="notas">Excelente dominio de los conceptos iniciales.</field>
        </record>

        <record id="demo_historial_admin_control" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_admin"/>
            <field name="slide_id" ref="demo_slide_python_control"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">28.0</field>
            <field name="intentos_quiz">2</field>
            <field name="puntuacion">88</field>
            <field name="fecha_acceso">2025-11-28 15:45:00</field>
            <field name="completado">True</field>
            <field name="notas">Reforzar estructuras de control anidadas.</field>
        </record>

        <record id="demo_historial_admin_oop" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_admin"/>
            <field name="slide_id" ref="demo_slide_python_oop"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">19.2</field>
            <field name="intentos_quiz">1</field>
            <field name="puntuacion">62</field>
            <field name="fecha_acceso">2025-12-01 11:20:00</field>
            <field name="completado">False</field>
            <field name="notas">Pendiente practicar herencia multiple.</field>
        </record>

        <record id="demo_historial_demo_basics" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_demo"/>
            <field name="slide_id" ref="demo_slide_python_basics"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">41.0</field>
            <field name="intentos_quiz">3</field>
            <field name="puntuacion">74</field>
            <field name="fecha_acceso">2025-11-26 18:05:00</field>
            <field name="completado">True</field>
            <field name="notas">Aprendizaje gradual con ejemplos guiados.</field>
        </record>

        <record id="demo_historial_demo_control" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_demo"/>
            <field name="slide_id" ref="demo_slide_python_control"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">34.7</field>
            <field name="intentos_quiz">2</field>
            <field name="puntuacion">69</field>
            <field name="fecha_acceso">2025-12-02 08:55:00</field>
            <field name="completado">False</field>
            <field name="notas">Dificultad con bucles while, necesita repaso.</field>
        </record>

        <record id="demo_historial_demo_oop" model="slide.historial.progreso">
            <field name="user_id" ref="base.user_demo"/>
            <field name="slide_id" ref="demo_slide_python_oop"/>
            <field name="channel_id" ref="demo_course_python"/>
            <field name="tiempo_dedicado">22.3</field>
            <field name="intentos_quiz">1</field>
            <field name="puntuacion">58</field>
            <field name="fecha_acceso">2025-12-03 10:40:00</field>
            <field name="completado">False</field>
            <field name="notas">Aun no completa ejercicios de clases y objetos.</field>
        </record>

    </data>
</odoo>
