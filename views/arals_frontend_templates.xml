<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =================== PLANTILLAS QWEB FRONTEND =================== -->

        <!-- Plantilla base para componentes ARALS -->
        <template id="arals_base_template" name="ARALS Base Template">
            <div class="arals-container">
                <div class="arals-header">
                    <h2 class="arals-title">
                        <i class="fa fa-graduation-cap"/> 
                        <t t-esc="title or 'ARALS - Sistema Adaptativo'"/>
                    </h2>
                </div>
                <div class="arals-content">
                    <t t-raw="0"/>
                </div>
            </div>
        </template>

        <template id="arals_recommendation_card" name="ARALS Recommendation Card">
            <div class="recommendation-card card mb-3" t-att-data-recommendation-id="recommendation.get('id')">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="recommendation-info pe-3">
                            <h6 class="card-title" t-esc="recommendation.get('title')"/>
                            <p class="card-text text-muted mb-2" t-esc="recommendation.get('description')"/>
                            <div class="recommendation-meta d-flex align-items-center">
                                <span class="badge"
                                      t-att-class="'badge-success' if recommendation.get('difficulty') == 'basico' else 'badge-info' if recommendation.get('difficulty') == 'intermedio' else 'badge-warning'"
                                      t-esc="recommendation.get('difficulty', '').title()"/>
                                <small class="text-muted ms-2">
                                    <i class="fa fa-clock-o"/> <t t-esc="recommendation.get('estimated_time', 0)"/> min
                                </small>
                            </div>
                        </div>
                        <div class="recommendation-actions text-center">
                            <div class="confidence-score mb-2">
                                <div class="score-circle"
                                     t-att-style="'--score: %s;' % int(recommendation.get('confidence', 0))">
                                    <span t-esc="int(recommendation.get('confidence', 0))"/>%
                                </div>
                                <small class="text-muted d-block">Confianza</small>
                            </div>
                            <a t-att-href="recommendation.get('url')"
                               class="btn btn-sm btn-primary">
                                Empezar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <template id="arals_learning_path_item" name="ARALS Learning Path Item">
              <div class="timeline-item"
                  t-att-class="'completed' if slide.get('completed') else 'pending'"
                 t-att-data-slide-id="slide.get('id')">
                <div class="timeline-marker">
                    <i t-att-class="'fa fa-check-circle text-success' if slide.get('completed') else 'fa fa-circle-o text-muted'"/>
                </div>
                <div class="timeline-content">
                    <div class="card">
                        <div class="card-body p-3">
                            <h6 class="card-title mb-1" t-esc="slide.get('title')"/>
                            <p class="card-text small text-muted mb-2" t-esc="slide.get('description')"/>
                            <div class="slide-meta d-flex justify-content-between align-items-center">
                                <div class="me-2">
                                    <span class="badge"
                                          t-att-class="'badge-success' if slide.get('difficulty') == 'basico' else 'badge-info' if slide.get('difficulty') == 'intermedio' else 'badge-warning'"
                                          t-esc="slide.get('difficulty', '').title()"/>
                                    <span class="badge badge-secondary ms-1" t-esc="slide.get('type', '').title()"/>
                                </div>
                                <div>
                                    <t t-if="slide.get('completed')">
                                        <span class="text-success small">
                                            <i class="fa fa-star"/> <t t-esc="slide.get('score', 0)"/>%
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <a t-att-href="slide.get('url')" class="btn btn-sm btn-outline-primary">
                                            <t t-if="slide.get('in_progress')">Continuar</t>
                                            <t t-else="">Empezar</t>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Bloque personalizado de la ruta dentro del curso -->
        <template id="course_slides_list_arals_personalized" inherit_id="website_slides.course_slides_list">
            <xpath expr="//div[contains(@class, 'o_wslides_slides_list')]/ul" position="before">
                <t t-if="arals_learning_path and arals_learning_path.get('slides')">
                    <div class="o_arals_personalized_wrapper border rounded bg-white shadow-sm mb-4">
                        <div class="o_arals_personalized_header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between px-3 py-3 border-bottom bg-100">
                            <div>
                                <h5 class="mb-1">
                                    <i class="fa fa-road text-primary me-2"/>
                                    <t t-esc="arals_learning_path.get('name', 'Tu Ruta Personalizada')"/>
                                </h5>
                                <p class="mb-0 text-muted">
                                    Contenido priorizado según tu progreso y perfil de aprendizaje.
                                </p>
                            </div>
                            <div class="d-flex align-items-center mt-3 mt-md-0">
                                <span class="badge text-bg-primary me-2">
                                    <i class="fa fa-percent me-1"/>
                                    <t t-esc="int(arals_learning_path.get('progress', 0))"/>%
                                </span>
                                <span class="text-muted">
                                    <t t-esc="len(arals_learning_path.get('slides'))"/> lecciones
                                </span>
                            </div>
                        </div>

                        <ul class="list-unstyled mb-0">
                            <t t-set="category_id" t-value="False"/>
                            <t t-set="j" t-value="0"/>
                            <t t-foreach="arals_learning_path_slides" t-as="slide">
                                <t t-call="website_slides.course_slides_list_slide"/>
                                <t t-set="j" t-value="j + 1"/>
                            </t>
                        </ul>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- Widget de Progreso Adaptativo -->
        <template id="arals_progress_widget" name="ARALS Progress Widget">
            <div class="arals-progress-widget card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa fa-chart-line text-primary"/> Tu Progreso Personalizado
                    </h5>
                    <button class="btn btn-sm btn-outline-primary" data-action="refresh-progress">
                        <i class="fa fa-refresh"/> Actualizar
                    </button>
                </div>
                <div class="card-body">
                    <div class="progress-stats row">
                        <div class="col-md-4 text-center">
                            <div class="stat-box">
                                <h3 class="text-success" data-stat="completed" t-esc="progress_data.get('completed', 0)"/>
                                <small class="text-muted">Completadas</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="stat-box">
                                <h3 class="text-info" data-stat="in_progress" t-esc="progress_data.get('in_progress', 0)"/>
                                <small class="text-muted">En Progreso</small>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="stat-box">
                                <h3 class="text-warning" data-stat="recommended" t-esc="progress_data.get('recommended', 0)"/>
                                <small class="text-muted">Recomendadas</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="overall-progress mt-3">
                        <label class="form-label">Progreso General</label>
                        <div class="progress mb-2">
                            <div class="progress-bar bg-success" 
                                 data-role="progress-bar"
                                 t-att-style="'width: ' + str(progress_data.get('percentage', 0)) + '%'"
                                 t-att-aria-valuenow="progress_data.get('percentage', 0)"
                                 aria-valuemin="0" aria-valuemax="100">
                                <span data-role="progress-label" t-esc="progress_data.get('percentage', 0)"/>%
                            </div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>
                                <i class="fa fa-clock-o me-1"/>
                                <span data-stat="total_time" t-esc="progress_data.get('total_time', 0)"/> min dedicados
                            </span>
                            <span>
                                <i class="fa fa-calendar me-1"/>
                                <span data-stat="last_activity" t-esc="progress_data.get('last_activity') or '-'"/>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Panel de Recomendaciones Personalizadas -->
        <template id="arals_recommendations_panel" name="ARALS Recommendations Panel">
            <div class="arals-recommendations-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>
                        <i class="fa fa-lightbulb-o text-warning"/> Recomendado para ti
                    </h4>
                    <span class="badge badge-info" data-role="recommendation-count" t-esc="len(recommendations)"/> contenidos
                </div>
                
                <div class="alert alert-info" data-role="empty-state" t-attf-class="alert alert-info {{ 'd-none' if recommendations else '' }}">
                    <i class="fa fa-info-circle"/> 
                    No hay recomendaciones disponibles. Completa más contenido para recibir sugerencias personalizadas.
                </div>
                
                <div class="recommendations-grid" t-attf-class="recommendations-grid {{ '' if recommendations else 'd-none' }}">
                    <t t-foreach="recommendations" t-as="recommendation">
                        <t t-call="tesis_website_slide_arals.arals_recommendation_card"/>
                    </t>
                </div>
            </div>
        </template>

        <!-- Ruta de Aprendizaje Visual -->
        <template id="arals_learning_path" name="ARALS Learning Path">
            <div class="arals-learning-path">
                <div class="path-header text-center mb-4">
                    <h3>
                        <i class="fa fa-road text-primary"/> Tu Ruta de Aprendizaje
                    </h3>
                    <p class="text-muted">
                        Ruta personalizada basada en tu perfil de aprendizaje
                    </p>
                </div>

                <div class="path-visualization">
                    <div class="path-timeline" data-role="learning-path-wrapper" t-attf-class="path-timeline {{ '' if learning_path and learning_path.get('slides') else 'd-none' }}">
                        <div data-role="learning-path-items">
                            <t t-if="learning_path">
                                <t t-foreach="learning_path.get('slides', [])" t-as="slide">
                                    <t t-call="tesis_website_slide_arals.arals_learning_path_item"/>
                                </t>
                            </t>
                        </div>
                    </div>
                    <div class="alert alert-info text-center" data-role="learning-path-empty" t-attf-class="alert alert-info {{ 'd-none' if learning_path and learning_path.get('slides') else '' }}">
                        <i class="fa fa-info-circle fa-2x text-primary mb-2"/>
                        <h5>¡Construyamos tu ruta de aprendizaje!</h5>
                        <p>Completa una evaluación inicial para que podamos crear una ruta personalizada para ti.</p>
                        <button class="btn btn-primary" data-action="start-assessment">
                            <i class="fa fa-play"/> Empezar Evaluación
                        </button>
                    </div>
                </div>
            </div>
        </template>

        <!-- Panel de Estadísticas del Estudiante -->
        <template id="arals_student_stats" name="ARALS Student Statistics">
            <div class="arals-student-stats">
                <div class="row">
                    <div class="col-md-3">
                        <div class="stat-card card text-center">
                            <div class="card-body">
                                <div class="stat-icon">
                                    <i class="fa fa-trophy text-warning fa-2x"/>
                                </div>
                                <h4 class="stat-number" data-stat="achievements" t-esc="stats.get('achievements', 0)"/>
                                <p class="stat-label text-muted">Logros</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card card text-center">
                            <div class="card-body">
                                <div class="stat-icon">
                                    <i class="fa fa-fire text-danger fa-2x"/>
                                </div>
                                <h4 class="stat-number" data-stat="streak" t-esc="stats.get('streak', 0)"/>
                                <p class="stat-label text-muted">Días Consecutivos</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card card text-center">
                            <div class="card-body">
                                <div class="stat-icon">
                                    <i class="fa fa-clock-o text-info fa-2x"/>
                                </div>
                                <h4 class="stat-number" data-stat="total_hours" t-esc="stats.get('total_hours', 0)"/>
                                <p class="stat-label text-muted">Horas Totales</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card card text-center">
                            <div class="card-body">
                                <div class="stat-icon">
                                    <i class="fa fa-star text-success fa-2x"/>
                                </div>
                                <h4 class="stat-number" data-stat="avg_score" t-esc="stats.get('avg_score', 0)"/>
                                <p class="stat-label text-muted">Puntuación Media</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Widget de Perfil de Aprendizaje -->
        <template id="arals_learning_profile" name="ARALS Learning Profile">
            <div class="arals-learning-profile card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa fa-user-circle text-primary"/> Tu Perfil de Aprendizaje
                    </h5>
                </div>
                <div class="card-body">
                    <div class="profile-overview row">
                        <div class="col-md-6">
                            <h6>Estilo de Aprendizaje</h6>
                            <div class="learning-style-indicator">
                                <div class="style-bar">
                                    <label>Visual</label>
                                    <div class="progress">
                                        <div class="progress-bar bg-info" 
                                             data-profile="visual"
                                             t-att-style="'width: ' + str(profile.get('visual', 0)) + '%'">
                                        </div>
                                    </div>
                                    <small class="text-muted"><span data-profile="visual-value" t-esc="str(profile.get('visual', 0))"/>%</small>
                                </div>
                                <div class="style-bar">
                                    <label>Auditivo</label>
                                    <div class="progress">
                                        <div class="progress-bar bg-warning" 
                                             data-profile="auditory"
                                             t-att-style="'width: ' + str(profile.get('auditory', 0)) + '%'">
                                        </div>
                                    </div>
                                    <small class="text-muted"><span data-profile="auditory-value" t-esc="str(profile.get('auditory', 0))"/>%</small>
                                </div>
                                <div class="style-bar">
                                    <label>Kinestésico</label>
                                    <div class="progress">
                                        <div class="progress-bar bg-success" 
                                             data-profile="kinesthetic"
                                             t-att-style="'width: ' + str(profile.get('kinesthetic', 0)) + '%'">
                                        </div>
                                    </div>
                                    <small class="text-muted"><span data-profile="kinesthetic-value" t-esc="str(profile.get('kinesthetic', 0))"/>%</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>Preferencias</h6>
                            <ul class="list-unstyled">
                                <li>
                                    <i class="fa fa-clock-o text-info"/> 
                                    Mejor momento: <strong data-profile-label="best_time" t-esc="profile.get('best_time', 'Mañana')"/>
                                </li>
                                <li>
                                    <i class="fa fa-dashboard text-warning"/> 
                                    Ritmo preferido: <strong data-profile-label="pace" t-esc="profile.get('pace', 'Moderado')"/>
                                </li>
                                <li>
                                    <i class="fa fa-target text-success"/> 
                                    Nivel actual: <strong data-profile-label="level" t-esc="profile.get('level', 'Intermedio')"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Notificaciones Adaptativas -->
        <template id="arals_adaptive_notifications" name="ARALS Adaptive Notifications">
            <div class="arals-notifications">
                <t t-foreach="notifications" t-as="notification">
                    <div class="alert" 
                         t-att-class="'alert-' + notification.get('type', 'info') + ' alert-dismissible fade show'"
                         role="alert">
                        <i t-att-class="'fa ' + notification.get('icon', 'fa-info-circle')"/>
                        <strong t-esc="notification.get('title', '')"/>
                        <span t-esc="notification.get('message', '')"/>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                    </div>
                </t>
            </div>
        </template>

        <!-- =================== PLANTILLAS PARA PROFESORES =================== -->

        <!-- Panel de Control del Profesor -->
        <template id="arals_teacher_control_panel" name="ARALS Teacher Control Panel">
            <div class="arals-teacher-panel">
                <div class="panel-header d-flex justify-content-between align-items-center mb-4">
                    <h3>
                        <i class="fa fa-chalkboard-teacher text-primary"/> Panel de Control ARALS
                    </h3>
                    <div class="control-actions">
                        <button class="btn btn-outline-primary" data-action="export-analytics">
                            <i class="fa fa-download"/> Exportar Datos
                        </button>
                        <button class="btn btn-primary" data-action="generate-report">
                            <i class="fa fa-file-text"/> Generar Reporte
                        </button>
                    </div>
                </div>

                <div class="analytics-grid row">
                    <div class="col-lg-4 col-md-6 mb-3">
                        <div class="metric-card card">
                            <div class="card-body">
                                <h5>Estudiantes Activos</h5>
                                <h2 class="text-primary" t-esc="analytics.get('active_students', 0)"/>
                                <small class="text-muted">
                                    <i class="fa fa-arrow-up text-success"/> +12% este mes
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-3">
                        <div class="metric-card card">
                            <div class="card-body">
                                <h5>Tasa de Finalización</h5>
                                <h2 class="text-success" t-esc="analytics.get('completion_rate', 0)"/>%
                                <small class="text-muted">
                                    <i class="fa fa-arrow-up text-success"/> +5% desde el último mes
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-3">
                        <div class="metric-card card">
                            <div class="card-body">
                                <h5>Efectividad ARALS</h5>
                                <h2 class="text-info" t-esc="analytics.get('arals_effectiveness', 0)"/>%
                                <small class="text-muted">
                                    Precisión de recomendaciones
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

    </data>
</odoo>