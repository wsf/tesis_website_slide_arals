<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =================== DASHBOARDS Y REPORTES =================== -->

        <!-- Snippet informativo dentro del formulario estándar de cursos -->
        <record id="view_arals_dashboard" model="ir.ui.view">
            <field name="name">arals.dashboard.snippet</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[@class='oe_button_box']" position="after">
                    <div class="o_dashboard_arals alert alert-info mb-3">
                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                            <div class="mb-2 mb-md-0">
                                <h3 class="mb-1">
                                    <span class="fa fa-graduation-cap me-2"/>Dashboard ARALS
                                </h3>
                                <span class="text-muted">Sistema Adaptativo de Recomendación para Aprendizaje</span>
                            </div>
                            <div class="text-md-end">
                                <strong class="me-2">Utiliza los menús laterales para:</strong>
                                <ul class="mb-0 ps-3">
                                    <li>Gestionar rutas de aprendizaje</li>
                                    <li>Revisar el historial de progreso</li>
                                    <li>Analizar métricas del curso</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>