<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =================== DASHBOARDS Y REPORTES =================== -->

        <!-- Dashboard Principal ARALS (Simplificado) -->
        <record id="view_arals_dashboard" model="ir.ui.view">
            <field name="name">arals.dashboard</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <form string="Dashboard ARALS - Vista Simplificada" create="false" edit="false">
                    <sheet>
                        <div class="o_dashboard_arals">
                            <div class="row">
                                <div class="col-lg-12">
                                    <h1>
                                        <span class="fa fa-graduation-cap"/> Dashboard ARALS
                                        <small class="text-muted">Sistema Adaptativo de Recomendación para Aprendizaje</small>
                                    </h1>
                                </div>
                            </div>

                            <!-- Información básica del curso -->
                            <div class="row o_dashboard_section">
                                <div class="col-lg-12">
                                    <h3>Información del Curso</h3>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Nombre:</strong> <field name="name" readonly="1"/></p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Estado:</strong> <field name="visibility" readonly="1"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Acciones disponibles -->
                            <div class="row o_dashboard_section">
                                <div class="col-lg-12">
                                    <h3>Acciones Rápidas</h3>
                                    <div class="alert alert-info">
                                        <h4>¡Bienvenido al Sistema ARALS!</h4>
                                        <p>Para acceder a las funciones del sistema, utilice los menús principales:</p>
                                        <ul>
                                            <li><strong>Historial de Progreso:</strong> Vea el progreso detallado de los estudiantes</li>
                                            <li><strong>Rutas de Aprendizaje:</strong> Gestione rutas personalizadas de aprendizaje</li>
                                            <li><strong>Análisis:</strong> Use las vistas pivot y gráficos para reportes</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>